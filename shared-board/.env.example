# Copy this file to .env on the server and replace the passwords.
# Do not commit the real .env file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
BOARD_DATA_DIR=./data
# Administrator level (owner/editor). An administrator can do everything a user
# can and additionally open the admin workspace in /home (管理后台 button).
OWNER_USERNAME=QbaiW
OWNER_PASSWORD=replace-with-a-long-random-password
# User level: the everyday account for the site pages and features.
SITE_USERNAME=Yuna
SITE_PASSWORD=replace-with-a-long-random-password
SESSION_HOURS=12
