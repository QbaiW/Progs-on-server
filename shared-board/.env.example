# Copy this file to .env on the server and replace the passwords.
# Do not commit the real .env file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
BOARD_DATA_DIR=./data
# Administrator (owner/editor) login. The owner login requires BOTH this account
# and the OWNER_PASSWORD; it is separate from the visitor/site credential.
OWNER_USERNAME=QbaiW
OWNER_PASSWORD=replace-with-a-long-random-password
# Visitors must enter both values before any site page is served.
SITE_USERNAME=QbaiW
SITE_PASSWORD=replace-with-a-long-random-password
SESSION_HOURS=12
