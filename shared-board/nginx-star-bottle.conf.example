# BaoTa can create the site and SSL certificate for the domain. Use these
# proxy settings for the Node service at 127.0.0.1:8787.
server {
    listen 80;
    server_name star.example.com;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite client-supplied forwarding headers. The Node service only
        # trusts them when the direct peer is this local reverse proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for /api/events Server-Sent Events.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
